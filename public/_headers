# ──────────────────────────────────────────
# Global security headers
# ──────────────────────────────────────────
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()

# ──────────────────────────────────────────
# Content-Security-Policy
# 'unsafe-inline' needed for:
#   - layout.tsx anti-flicker theme <script>
#   - layout.tsx JSON-LD structured data
#   - Next.js inline style hydration
# Connect sources: api.deepseek.com (AI), tile.openstreetmap.org (map)
# ──────────────────────────────────────────
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://tile.openstreetmap.org; connect-src 'self' https://api.deepseek.com https://tile.openstreetmap.org; font-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'

# ──────────────────────────────────────────
# Static assets with content hash — immutable
# ──────────────────────────────────────────
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# ──────────────────────────────────────────
# Images & assets
# ──────────────────────────────────────────
/*.png
  Cache-Control: public, max-age=31536000, immutable

/*.svg
  Cache-Control: public, max-age=604800, must-revalidate

/*.json
  Cache-Control: public, max-age=3600, must-revalidate

# ──────────────────────────────────────────
# HTML — short TTL with stale-while-revalidate
# Cloudflare CDN serves stale during revalidation
# ──────────────────────────────────────────
/*.html
  Cache-Control: public, max-age=0, must-revalidate, stale-while-revalidate=3600
