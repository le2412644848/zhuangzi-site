# ──────────────────────────────────────────
# Global security headers
# ──────────────────────────────────────────
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload

# ──────────────────────────────────────────
# Content-Security-Policy
# 'unsafe-inline' needed for:
#   - layout.tsx anti-flicker theme <script>
#   - layout.tsx JSON-LD structured data
#   - Next.js inline style hydration
# img-src: 高德瓦片(webrd0{1-4}.is.autonavi.com) + Leaflet 标记图标(cdnjs)
# connect-src: api.deepseek.com (AI), 高德瓦片
# ──────────────────────────────────────────
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://tile.openstreetmap.org https://webrd01.is.autonavi.com https://webrd02.is.autonavi.com https://webrd03.is.autonavi.com https://webrd04.is.autonavi.com https://cdnjs.cloudflare.com; connect-src 'self' https://api.deepseek.com https://tile.openstreetmap.org https://webrd01.is.autonavi.com https://webrd02.is.autonavi.com https://webrd03.is.autonavi.com https://webrd04.is.autonavi.com; font-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'

# ──────────────────────────────────────────
# Static assets with content hash — immutable
# ──────────────────────────────────────────
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# ──────────────────────────────────────────
# Images & assets
# ──────────────────────────────────────────
/*.png
  Cache-Control: public, max-age=31536000, immutable

/*.svg
  Cache-Control: public, max-age=604800, must-revalidate

/*.json
  Cache-Control: public, max-age=3600, must-revalidate

# ──────────────────────────────────────────
# HTML — short TTL with stale-while-revalidate
# Cloudflare CDN serves stale during revalidation
# ──────────────────────────────────────────
/*.html
  Cache-Control: public, max-age=0, must-revalidate, stale-while-revalidate=3600
